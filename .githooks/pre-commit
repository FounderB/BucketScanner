#!/bin/sh
# Block commits authored outside FounderB identity in this repository.

set -eu

# GIT_AUTHOR_IDENT is "Name <email> timestamp tz" — compare identity only.
author=$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -E 's/ [0-9]+ [+-][0-9]+$//' || true)
expected='FounderB <314388178+FounderB@users.noreply.github.com>'

if [ "$author" != "$expected" ]; then
  echo "error: commit author must be $expected" >&2
  echo "  got: ${author:-unknown}" >&2
  echo "hint: run scripts/setup-git-hooks.sh and commit with --author=\"$expected\"" >&2
  exit 1
fi
