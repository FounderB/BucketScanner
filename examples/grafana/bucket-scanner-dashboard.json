{
  "title": "Bucket Scanner",
  "uid": "bucket-scanner-founderB",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "tags": ["bucket-scanner", "cloud-security"],
  "templating": {
    "list": [
      {
        "name": "cloud",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": "label_values(bucket_scanner_score, cloud)",
        "refresh": 2,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "scope_id",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": "label_values(bucket_scanner_score{cloud=\"$cloud\"}, scope_id)",
        "refresh": 2,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Risk score",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "bucket_scanner_score{cloud=\"$cloud\",scope_id=\"$scope_id\"}",
          "legendFormat": "{{cloud}}/{{scope_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Critical findings",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "expr": "bucket_scanner_findings_total{cloud=\"$cloud\",scope_id=\"$scope_id\",severity=\"critical\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Buckets scanned",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "bucket_scanner_buckets_scanned{cloud=\"$cloud\",scope_id=\"$scope_id\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Misconfig chains",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [
        {
          "expr": "bucket_scanner_chains_total{cloud=\"$cloud\",scope_id=\"$scope_id\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Findings by severity",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {
          "expr": "bucket_scanner_findings_total{cloud=\"$cloud\",scope_id=\"$scope_id\"}",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Risk score over time",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {
          "expr": "bucket_scanner_score{cloud=\"$cloud\",scope_id=\"$scope_id\"}",
          "legendFormat": "{{cloud}}/{{scope_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Findings by rule",
      "gridPos": {"h": 8, "w": 16, "x": 0, "y": 12},
      "targets": [
        {
          "expr": "bucket_scanner_findings_by_rule{cloud=\"$cloud\",scope_id=\"$scope_id\"}",
          "legendFormat": "{{rule_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Scan duration (ms)",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12},
      "targets": [
        {
          "expr": "bucket_scanner_scan_duration_ms{cloud=\"$cloud\",scope_id=\"$scope_id\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
